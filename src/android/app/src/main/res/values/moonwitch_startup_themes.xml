<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Android 12+ always renders a system splash before the first Activity.
        Keep that layer blank; MoonwitchSplashActivity owns the visible branding.
    -->
    <style name="Theme.Moonwitch.Startup.Boot" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/eden_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_moonwitch_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.Moonwitch.Startup.Content</item>
    </style>

    <style name="Theme.Moonwitch.Startup.Content" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/eden_background</item>
        <item name="android:colorBackground">@color/eden_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
