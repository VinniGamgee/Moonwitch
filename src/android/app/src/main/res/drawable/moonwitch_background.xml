<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#07070F"
                android:startColor="#0B0812" />
        </shape>
    </item>
    <item android:left="-190dp" android:right="150dp" android:top="-170dp" android:bottom="110dp">
        <shape android:shape="oval">
            <gradient
                android:centerColor="#249B4DFF"
                android:endColor="#009B4DFF"
                android:gradientRadius="250dp"
                android:startColor="#3A9B4DFF"
                android:type="radial" />
        </shape>
    </item>
    <item android:left="150dp" android:right="-190dp" android:top="90dp" android:bottom="-190dp">
        <shape android:shape="oval">
            <gradient
                android:centerColor="#18B768FF"
                android:endColor="#00B768FF"
                android:gradientRadius="270dp"
                android:startColor="#30B768FF"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
