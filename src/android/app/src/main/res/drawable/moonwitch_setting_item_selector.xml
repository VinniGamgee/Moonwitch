<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#D9222A38" />
            <stroke android:width="1dp" android:color="#8035D8FF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#D91A202C" />
            <stroke android:width="1dp" android:color="#99FF3B55" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#C9141822" />
            <stroke android:width="1dp" android:color="#332DDAFF" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
