<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/moonwitch_background">

    <ImageView android:layout_width="300dp" android:layout_height="300dp" android:alpha="0.024" android:contentDescription="@null" android:src="@drawable/ic_moonwitch_mark" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/header_settings" android:layout_width="0dp" android:layout_height="72dp" android:layout_marginStart="20dp" android:layout_marginTop="8dp" android:layout_marginEnd="20dp" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent">
        <ImageView android:id="@+id/settings_brand_mark" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="@string/app_name" android:src="@drawable/ic_moonwitch_mark" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:orientation="vertical" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toStartOf="@id/settings_shortcut_card" app:layout_constraintStart_toEndOf="@id/settings_brand_mark" app:layout_constraintTop_toTopOf="parent">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:letterSpacing="0.10" android:maxLines="1" android:text="@string/app_name" android:textAllCaps="true" android:textColor="@color/moonwitch_text" android:textSize="23sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:fontFamily="sans-serif-medium" android:letterSpacing="0.22" android:text="@string/mw_settings" android:textColor="@color/moonwitch_cyan" android:textSize="9sp"/>
        </LinearLayout>
        <com.google.android.material.card.MaterialCardView android:id="@+id/settings_shortcut_card" android:layout_width="44dp" android:layout_height="44dp" android:clickable="true" android:contentDescription="@string/advanced_settings" android:focusable="true" app:cardBackgroundColor="@color/moonwitch_panel_high" app:cardCornerRadius="14dp" app:cardElevation="0dp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:rippleColor="#30FF3B55" app:strokeColor="@color/moonwitch_border" app:strokeWidth="1dp">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:layout_gravity="center" android:contentDescription="@null" android:src="@drawable/ic_settings" app:tint="@color/moonwitch_red"/>
        </com.google.android.material.card.MaterialCardView>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.card.MaterialCardView android:id="@+id/settings_search_shell" android:layout_width="0dp" android:layout_height="54dp" android:layout_marginStart="18dp" android:layout_marginTop="3dp" android:layout_marginEnd="18dp" app:cardBackgroundColor="@color/moonwitch_panel_soft" app:cardCornerRadius="18dp" app:cardElevation="0dp" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/header_settings" app:strokeColor="@color/moonwitch_border_soft" app:strokeWidth="1dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="14dp">
            <ImageView android:layout_width="20dp" android:layout_height="20dp" android:contentDescription="@null" android:src="@drawable/ic_search" app:tint="@color/moonwitch_cyan"/>
            <EditText android:id="@+id/settings_search_text" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="10dp" android:layout_weight="1" android:background="@android:color/transparent" android:hint="@string/mw_search_settings" android:imeOptions="flagNoFullscreen" android:inputType="text" android:maxLines="1" android:textColor="@color/moonwitch_text" android:textColorHint="@color/moonwitch_text_muted" android:textSize="13sp"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <androidx.core.widget.NestedScrollView android:id="@+id/scroll_view_settings" android:layout_width="0dp" android:layout_height="0dp" android:clipToPadding="false" android:fillViewport="true" android:overScrollMode="never" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/settings_search_shell">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="14dp" android:paddingTop="16dp" android:paddingEnd="14dp" android:paddingBottom="24dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:fontFamily="sans-serif-medium" android:letterSpacing="0.16" android:text="@string/mw_main_settings" android:textColor="@color/moonwitch_text_muted" android:textSize="9.5sp"/>
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/home_settings_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:clipToPadding="false" android:nestedScrollingEnabled="false"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_marginTop="18dp" android:layout_marginEnd="6dp" android:gravity="center_vertical" android:orientation="horizontal">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="@null" android:src="@drawable/ic_mw_gauge" app:tint="@color/moonwitch_cyan"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:letterSpacing="0.12" android:text="@string/mw_performance_center" android:textColor="@color/moonwitch_text" android:textSize="12sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/mw_performance_center_desc" android:textColor="@color/moonwitch_text_muted" android:textSize="9.5sp"/>
                </LinearLayout>
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/performance_settings_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:clipToPadding="false" android:nestedScrollingEnabled="false"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:layout_marginTop="18dp" android:fontFamily="sans-serif-medium" android:letterSpacing="0.16" android:text="@string/mw_information" android:textColor="@color/moonwitch_text_muted" android:textSize="9.5sp"/>
            <com.google.android.material.card.MaterialCardView android:id="@+id/help_card" android:layout_width="match_parent" android:layout_height="64dp" android:layout_marginTop="9dp" android:clickable="true" android:focusable="true" app:cardBackgroundColor="@color/moonwitch_panel_soft" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:rippleColor="#3035D8FF" app:strokeColor="@color/moonwitch_border_soft" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="14dp">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="@null" android:src="@drawable/ic_info_outline" app:tint="@color/moonwitch_cyan"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/mw_about" android:textColor="@color/moonwitch_text" android:textSize="12sp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/mw_about_desc" android:textColor="@color/moonwitch_text_muted" android:textSize="9.5sp"/>
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textColor="@color/moonwitch_text_muted" android:textSize="24sp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
