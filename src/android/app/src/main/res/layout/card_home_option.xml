<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/option_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginBottom="6dp"
    android:background="@android:color/transparent"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/moonwitch_panel_soft"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:rippleColor="#2035D8FF"
    app:strokeColor="@color/moonwitch_border_soft"
    app:strokeWidth="1dp">

    <LinearLayout
        android:id="@+id/option_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="72dp">

        <ImageView
            android:id="@+id/option_icon"
            android:layout_width="23dp"
            android:layout_height="23dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="16dp"
            app:tint="@color/moonwitch_cyan" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="10dp"
            android:orientation="vertical">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/option_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textAlignment="viewStart"
                android:textColor="@color/moonwitch_text"
                android:textSize="14sp"
                tools:text="@string/install_prod_keys" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/option_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAlignment="viewStart"
                android:textColor="@color/moonwitch_text_muted"
                android:textSize="12sp"
                tools:text="@string/install_prod_keys_description" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/option_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAlignment="viewStart"
                android:textColor="@color/moonwitch_cyan"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="/tree/primary:Games"
                tools:visibility="visible" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
