<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="5dp"
    app:cardBackgroundColor="@color/moonwitch_panel_soft"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/moonwitch_border_soft"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="74dp"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="11dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="42dp"
            android:layout_height="42dp"
            app:cardBackgroundColor="@color/moonwitch_panel_high"
            app:cardCornerRadius="13dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/moonwitch_border"
            app:strokeWidth="1dp">

            <ImageView
                android:id="@+id/icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                app:tint="@color/moonwitch_cyan"
                tools:src="@drawable/ic_save" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/moonwitch_text"
                android:textSize="12.5sp"
                tools:text="Dados salvos" />

            <TextView
                android:id="@+id/description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="2"
                android:textColor="@color/moonwitch_text_muted"
                android:textSize="9.5sp"
                tools:text="Gerencie dados salvos específicos deste jogo" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_install"
            style="@style/Widget.Material3.Button.IconButton.Filled"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/moonwitch_red"
            android:contentDescription="@string/string_import"
            android:tooltipText="@string/string_import"
            android:visibility="gone"
            app:icon="@drawable/ic_import"
            app:iconTint="@android:color/white"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_export"
            style="@style/Widget.Material3.Button.IconButton.Filled"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:backgroundTint="@color/moonwitch_panel_high"
            android:contentDescription="@string/export"
            android:tooltipText="@string/export"
            android:visibility="gone"
            app:icon="@drawable/ic_export"
            app:iconTint="@color/moonwitch_cyan"
            tools:visibility="visible" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
