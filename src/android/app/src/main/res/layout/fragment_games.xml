<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/moonwitch_background"
    android:clipChildren="false">

    <ImageView
        android:id="@+id/ambient_logo"
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:alpha="0.03"
        android:contentDescription="@null"
        android:src="@drawable/ic_moonwitch_mark"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:layout_marginStart="14dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="14dp"
        app:cardBackgroundColor="@color/moonwitch_panel"
        app:cardCornerRadius="22dp"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeColor="@color/moonwitch_border"
        app:strokeWidth="1dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/brand_mark"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="14dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_moonwitch_mark"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout
                android:id="@+id/brand_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/settings_button"
                app:layout_constraintStart_toEndOf="@id/brand_mark"
                app:layout_constraintTop_toTopOf="parent">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.08"
                    android:maxLines="1"
                    android:text="@string/app_name"
                    android:textAllCaps="true"
                    android:textColor="@color/moonwitch_text"
                    android:textSize="18sp" />

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.16"
                    android:text="@string/moonwitch_command_center"
                    android:textColor="@color/moonwitch_cyan"
                    android:textSize="9sp" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/settings_button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="12dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/moonwitch_panel_high"
                app:cardCornerRadius="13dp"
                app:cardElevation="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:rippleColor="#30FF3B55"
                app:strokeColor="@color/moonwitch_border"
                app:strokeWidth="1dp">

                <ImageView
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_settings"
                    app:tint="@color/moonwitch_red" />
            </com.google.android.material.card.MaterialCardView>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/library_tools"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginStart="14dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="14dp"
        app:cardBackgroundColor="@color/moonwitch_panel_soft"
        app:cardCornerRadius="17dp"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header"
        app:strokeColor="@color/moonwitch_border_soft"
        app:strokeWidth="1dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/view_button"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/moonwitch_panel_high"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:rippleColor="#3035D8FF"
                app:strokeColor="@color/moonwitch_border"
                app:strokeWidth="1dp">

                <ImageView
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_eye"
                    app:tint="@color/moonwitch_cyan" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/filter_button"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/moonwitch_panel_high"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/view_button"
                app:layout_constraintTop_toTopOf="parent"
                app:rippleColor="#3035D8FF"
                app:strokeColor="@color/moonwitch_border"
                app:strokeWidth="1dp">

                <ImageView
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_filter"
                    app:tint="@color/moonwitch_text_muted" />
            </com.google.android.material.card.MaterialCardView>

            <FrameLayout
                android:id="@+id/frame_search"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginStart="7dp"
                android:layout_marginEnd="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/filter_button"
                app:layout_constraintTop_toTopOf="parent">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/search_background"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/moonwitch_panel_high"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:rippleColor="#2035D8FF"
                    app:strokeColor="@color/moonwitch_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:id="@+id/search_container"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginStart="11dp"
                        android:layout_marginEnd="36dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="17dp"
                            android:layout_height="17dp"
                            android:layout_marginEnd="8dp"
                            android:src="@drawable/ic_search"
                            app:tint="@color/moonwitch_cyan" />

                        <EditText
                            android:id="@+id/search_text"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@android:color/transparent"
                            android:fontFamily="sans-serif"
                            android:hint="@string/home_search_games"
                            android:imeOptions="flagNoFullscreen"
                            android:inputType="text"
                            android:maxLines="1"
                            android:textColor="@color/moonwitch_text"
                            android:textColorHint="@color/moonwitch_text_muted"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/clear_button"
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:layout_gravity="center_vertical|end"
                        android:layout_marginEnd="11dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_clear"
                        android:visibility="invisible"
                        app:tint="@color/moonwitch_text_muted" />
                </com.google.android.material.card.MaterialCardView>
            </FrameLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/library_section_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="12dp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.16"
        android:text="@string/moonwitch_select_game"
        android:textColor="@color/moonwitch_text_muted"
        android:textSize="10sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/library_tools" />

    <View
        android:layout_width="48dp"
        android:layout_height="2dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/moonwitch_accent_line"
        app:layout_constraintBottom_toBottomOf="@id/library_section_label"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/library_section_label" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="6dp"
        app:layout_constraintBottom_toTopOf="@id/bottom_dock"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/library_section_label">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/notice_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:padding="@dimen/spacing_large"
                android:text="@string/empty_gamelist"
                android:textColor="@color/moonwitch_text_muted"
                android:textSize="15sp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/grid_games"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:fadeScrollbars="true"
                android:paddingHorizontal="6dp"
                android:paddingVertical="4dp"
                android:scrollbarStyle="outsideOverlay"
                android:scrollbars="vertical" />
        </RelativeLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottom_dock"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="10dp"
        app:cardBackgroundColor="@color/moonwitch_panel_soft"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeColor="@color/moonwitch_border_soft"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="5dp">

            <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
                android:id="@+id/launch_qlaunch"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="0.78"
                android:layout_marginEnd="3dp"
                android:contentDescription="@string/moonwitch_system_menu"
                android:text="@string/moonwitch_system_menu"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                app:backgroundTint="@color/moonwitch_red"
                app:icon="@drawable/ic_home"
                app:iconSize="17dp"
                app:iconTint="@android:color/white"
                app:rippleColor="#55FFFFFF" />

            <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
                android:id="@+id/add_directory"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1.22"
                android:layout_marginStart="3dp"
                android:contentDescription="@string/moonwitch_manage_library"
                android:text="@string/moonwitch_manage_library"
                android:textColor="#041018"
                android:textSize="11sp"
                app:backgroundTint="@color/moonwitch_cyan"
                app:icon="@drawable/ic_cartridge_outline"
                app:iconSize="17dp"
                app:iconTint="#041018"
                app:rippleColor="#55FFFFFF" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
