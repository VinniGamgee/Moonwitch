    <com.google.android.material.card.MaterialCardView android:id="@+id/search_shell" android:layout_width="0dp" android:layout_height="56dp" android:layout_marginStart="18dp" android:layout_marginTop="4dp" android:layout_marginEnd="18dp" app:cardBackgroundColor="@color/moonwitch_panel_soft" app:cardCornerRadius="18dp" app:cardElevation="0dp" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/header" app:strokeColor="@color/moonwitch_border_soft" app:strokeWidth="1dp">
        <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/library_tools" android:layout_width="match_parent" android:layout_height="match_parent">
            <com.google.android.material.card.MaterialCardView android:id="@+id/search_background" android:layout_width="0dp" android:layout_height="42dp" android:layout_marginStart="8dp" android:layout_marginEnd="8dp" android:clickable="true" android:focusable="true" app:cardBackgroundColor="@color/moonwitch_panel_high" app:cardCornerRadius="14dp" app:cardElevation="0dp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toStartOf="@id/filter_button" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:rippleColor="#2035D8FF" app:strokeColor="@color/moonwitch_border" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginStart="12dp" android:layout_marginEnd="36dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <ImageView android:layout_width="19dp" android:layout_height="19dp" android:layout_marginEnd="10dp" android:src="@drawable/ic_search" app:tint="@color/moonwitch_cyan" />
                    <EditText android:id="@+id/search_text" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent" android:fontFamily="sans-serif" android:hint="@string/mw_search_games" android:imeOptions="flagNoFullscreen" android:inputType="text" android:maxLines="1" android:textColor="@color/moonwitch_text" android:textColorHint="@color/moonwitch_text_muted" android:textSize="13sp" />
                </LinearLayout>
                <ImageView android:id="@+id/clear_button" android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="center_vertical|end" android:layout_marginEnd="11dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_clear" android:visibility="invisible" app:tint="@color/moonwitch_text_muted" />
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:id="@+id/filter_button" android:layout_width="42dp" android:layout_height="42dp" android:layout_marginEnd="8dp" android:clickable="true" android:focusable="true" app:cardBackgroundColor="@color/moonwitch_panel_high" app:cardCornerRadius="14dp" app:cardElevation="0dp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent" app:rippleColor="#3035D8FF" app:strokeColor="@color/moonwitch_border" app:strokeWidth="1dp">
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="center" android:src="@drawable/ic_filter" app:tint="@color/moonwitch_cyan" />
            </com.google.android.material.card.MaterialCardView>
            <View android:id="@+id/view_button" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout android:id="@+id/quick_actions" android:layout_width="0dp" android:layout_height="64dp" android:layout_marginStart="18dp" android:layout_marginTop="9dp" android:layout_marginEnd="18dp" android:gravity="center" android:orientation="horizontal" android:weightSum="4" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/search_shell">
        <com.google.android.material.card.MaterialCardView android:id="@+id/quick_recent" android:layout_width="0dp" android:layout_height="58dp" android:layout_marginEnd="4dp" android:layout_weight="1" android:clickable="true" android:focusable="true" app:cardBackgroundColor="@color/moonwitch_panel_soft" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:rippleColor="#3035D8FF" app:strokeColor="@color/moonwitch_border_soft" app:strokeWidth="1dp"><LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical"><ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_mw_clock" app:tint="@color/moonwitch_cyan"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/mw_recent" android:textColor="@color/moonwitch_text" android:textSize="10sp"/></LinearLayout></com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView android:id="@+id/quick_favorites" android:layout_width="0dp" android:layout_height="58dp" android:layout_marginHorizontal="4dp" android:layout_weight="1" android:clickable="true" android:focusable="true" app:cardBackgroundColor="@color/moonwitch_panel_soft" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:rippleColor="#30FF3B55" app:strokeColor="@color/moonwitch_border_soft" app:strokeWidth="1dp"><LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical"><ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_mw_heart" app:tint="@color/moonwitch_red"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/mw_favorites" android:textColor="@color/moonwitch_text" android:textSize="10sp"/></LinearLayout></com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView android:id="@+id/quick_performance" android:layout_width="0dp" android:layout_height="58dp" android:layout_marginHorizontal="4dp" android:layout_weight="1" android:clickable="true" android:focusable="true" app:cardBackgroundColor="@color/moonwitch_panel_soft" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:rippleColor="#3035D8FF" app:strokeColor="@color/moonwitch_border_soft" app:strokeWidth="1dp"><LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical"><ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_mw_gauge" app:tint="@color/moonwitch_cyan"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/mw_performance" android:textColor="@color/moonwitch_text" android:textSize="10sp"/></LinearLayout></com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView android:id="@+id/quick_filters" android:layout_width="0dp" android:layout_height="58dp" android:layout_marginStart="4dp" android:layout_weight="1" android:clickable="true" android:focusable="true" app:cardBackgroundColor="@color/moonwitch_panel_soft" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:rippleColor="#3035D8FF" app:strokeColor="@color/moonwitch_border_soft" app:strokeWidth="1dp"><LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical"><ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_filter" app:tint="@color/moonwitch_cyan"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/mw_filters" android:textColor="@color/moonwitch_text" android:textSize="10sp"/></LinearLayout></com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <com.google.android.material.textview.MaterialTextView android:id="@+id/recent_section_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="20dp" android:layout_marginTop="12dp" android:fontFamily="sans-serif-medium" android:letterSpacing="0.16" android:text="@string/mw_recently_played" android:textColor="@color/moonwitch_text_muted" android:textSize="9.5sp" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/quick_actions" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recent_games" android:layout_width="0dp" android:layout_height="122dp" android:layout_marginTop="5dp" android:clipToPadding="false" android:overScrollMode="never" android:paddingStart="14dp" android:paddingEnd="14dp" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/recent_section_label" />

    <com.google.android.material.textview.MaterialTextView android:id="@+id/library_section_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="20dp" android:layout_marginTop="10dp" android:fontFamily="sans-serif-medium" android:letterSpacing="0.16" android:text="@string/mw_library_upper" android:textColor="@color/moonwitch_text_muted" android:textSize="9.5sp" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/recent_games" />
    <com.google.android.material.textview.MaterialTextView android:id="@+id/library_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="20dp" android:text="0 jogos" android:textColor="@color/moonwitch_text_muted" android:textSize="9.5sp" app:layout_constraintBaseline_toBaselineOf="@id/library_section_label" app:layout_constraintEnd_toEndOf="parent" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout android:id="@+id/swipe_refresh" android:layout_width="0dp" android:layout_height="0dp" android:layout_marginTop="4dp" android:layout_marginBottom="5dp" app:layout_constraintBottom_toTopOf="@id/library_actions" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/library_section_label">
        <RelativeLayout android:layout_width="match_parent" android:layout_height="match_parent">
            <com.google.android.material.textview.MaterialTextView android:id="@+id/notice_text" android:layout_width="match_parent" android:layout_height="match_parent" android:fontFamily="sans-serif" android:gravity="center" android:padding="@dimen/spacing_large" android:text="@string/empty_gamelist" android:textColor="@color/moonwitch_text_muted" android:textSize="14sp" android:visibility="gone" />
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/grid_games" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:fadeScrollbars="true" android:paddingHorizontal="12dp" android:paddingVertical="2dp" android:scrollbarStyle="outsideOverlay" android:scrollbars="vertical" />
        </RelativeLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <LinearLayout android:id="@+id/library_actions" android:layout_width="0dp" android:layout_height="66dp" android:layout_marginStart="18dp" android:layout_marginEnd="18dp" android:layout_marginBottom="7dp" android:orientation="horizontal" android:weightSum="2" app:layout_constraintBottom_toTopOf="@id/bottom_dock" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent">
        <com.google.android.material.card.MaterialCardView android:id="@+id/add_directory" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="5dp" android:layout_weight="1" android:clickable="true" android:focusable="true" app:cardBackgroundColor="@color/moonwitch_panel_soft" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:rippleColor="#3035D8FF" app:strokeColor="@color/moonwitch_border_soft" app:strokeWidth="1dp"><LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical"><ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_add" app:tint="@color/moonwitch_cyan"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="@string/mw_add_games" android:textColor="@color/moonwitch_text_muted" android:textSize="10sp"/></LinearLayout></com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView android:id="@+id/explore_directory" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="5dp" android:layout_weight="1" android:clickable="true" android:focusable="true" app:cardBackgroundColor="@color/moonwitch_panel_soft" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:rippleColor="#3035D8FF" app:strokeColor="@color/moonwitch_border_soft" app:strokeWidth="1dp"><LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical"><ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_folder_open" app:tint="@color/moonwitch_text_muted"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="@string/mw_explore_folder" android:textColor="@color/moonwitch_text_muted" android:textSize="10sp"/></LinearLayout></com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView android:id="@+id/bottom_dock" android:layout_width="0dp" android:layout_height="64dp" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginBottom="8dp" app:cardBackgroundColor="@color/moonwitch_panel_soft" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:strokeColor="@color/moonwitch_border_soft" app:strokeWidth="1dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:weightSum="4">
            <LinearLayout android:id="@+id/nav_library" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical" android:paddingTop="7dp"><ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_mw_library" app:tint="@color/moonwitch_cyan"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/mw_library" android:textColor="@color/moonwitch_cyan" android:textSize="9.5sp"/><View android:layout_width="38dp" android:layout_height="2dp" android:layout_marginTop="5dp" android:background="@color/moonwitch_cyan"/></LinearLayout>
            <LinearLayout android:id="@+id/nav_recent" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical"><ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_mw_clock" app:tint="@color/moonwitch_text_muted"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/mw_recent" android:textColor="@color/moonwitch_text_muted" android:textSize="9.5sp"/></LinearLayout>
            <LinearLayout android:id="@+id/nav_collections" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical"><ImageView android:layout_width="23dp" android:layout_height="23dp" android:src="@drawable/ic_mw_layers" app:tint="@color/moonwitch_text_muted"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/mw_collections" android:textColor="@color/moonwitch_text_muted" android:textSize="9.5sp"/></LinearLayout>
            <LinearLayout android:id="@+id/nav_system" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical"><ImageView android:layout_width="23dp" android:layout_height="23dp" android:src="@drawable/ic_mw_system" app:tint="@color/moonwitch_text_muted"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/mw_system" android:textColor="@color/moonwitch_text_muted" android:textSize="9.5sp"/></LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <View android:id="@+id/launch_qlaunch" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
</androidx.constraintlayout.widget.ConstraintLayout>