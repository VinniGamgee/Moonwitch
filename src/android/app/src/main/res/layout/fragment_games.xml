<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mw_ui_bg">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="82dp"
        android:layout_marginStart="18dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="18dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/brand_mark"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_moonwitch_mark"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/brand_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/header_search_button"
            app:layout_constraintStart_toEndOf="@id/brand_mark"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.04"
                android:text="@string/app_name"
                android:textAllCaps="true"
                android:textColor="@color/mw_ui_text"
                android:textSize="21sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-2dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.20"
                android:text="@string/mw_ui_switch_emulator"
                android:textColor="@color/mw_ui_accent_hi"
                android:textSize="8.5sp" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/header_search_button"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginEnd="8dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/mw_ui_bg_soft"
            app:cardCornerRadius="23dp"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/header_more_button"
            app:layout_constraintTop_toTopOf="parent"
            app:rippleColor="#249147FF"
            app:strokeColor="@color/mw_ui_border"
            app:strokeWidth="1dp">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@string/search"
                android:src="@drawable/ic_search"
                app:tint="@color/mw_ui_text" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/header_more_button"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/mw_ui_bg_soft"
            app:cardCornerRadius="23dp"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:rippleColor="#249147FF"
            app:strokeColor="@color/mw_ui_border"
            app:strokeWidth="1dp">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@string/mw_ui_more"
                android:src="@drawable/ic_more_vert"
                app:tint="@color/mw_ui_text" />
        </com.google.android.material.card.MaterialCardView>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/screen_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="12dp"
        android:fontFamily="sans-serif-medium"
        android:text="@string/mw_ui_library"
        android:textColor="@color/mw_ui_text"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/search_tools"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/screen_title">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/search_background"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/mw_ui_surface"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/view_button"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeColor="@color/mw_ui_border"
            app:strokeWidth="1dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="12dp">
                <ImageView
                    android:layout_width="21dp"
                    android:layout_height="21dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_search"
                    app:tint="@color/mw_ui_text_2" />
                <EditText
                    android:id="@+id/search_text"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="@string/mw_search_games"
                    android:imeOptions="flagNoFullscreen"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="@color/mw_ui_text"
                    android:textColorHint="@color/mw_ui_text_2"
                    android:textSize="15sp" />
                <ImageView
                    android:id="@+id/clear_button"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/clear"
                    android:src="@drawable/ic_clear"
                    android:visibility="invisible"
                    app:tint="@color/mw_ui_text_2" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/view_button"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="10dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/mw_ui_accent_soft"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/filter_button"
            app:layout_constraintTop_toTopOf="parent"
            app:rippleColor="#309147FF"
            app:strokeColor="@color/mw_ui_border_accent"
            app:strokeWidth="1dp">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@string/view_grid"
                android:src="@drawable/ic_grid_view"
                app:tint="@color/mw_ui_accent" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/filter_button"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/mw_ui_surface"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:rippleColor="#249147FF"
            app:strokeColor="@color/mw_ui_border"
            app:strokeWidth="1dp">
            <ImageView
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:layout_gravity="center"
                android:contentDescription="@string/mw_filters"
                android:src="@drawable/ic_filter"
                app:tint="@color/mw_ui_text" />
        </com.google.android.material.card.MaterialCardView>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/tabs_container"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginStart="18dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="18dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/screen_title">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/tab_all"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/mw_ui_accent_soft"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/mw_ui_accent"
            app:strokeWidth="1dp">
            <TextView
                android:id="@+id/tab_all_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/mw_ui_all"
                android:textColor="@color/mw_ui_accent_hi"
                android:textSize="14sp" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/tab_recent"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/mw_ui_surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">
            <TextView android:id="@+id/tab_recent_text" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="@string/mw_ui_recent" android:textColor="@color/mw_ui_text_2" android:textSize="14sp" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/tab_favorites"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/mw_ui_surface"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">
            <TextView android:id="@+id/tab_favorites_text" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="@string/mw_ui_favorites" android:textColor="@color/mw_ui_text_2" android:textSize="14sp" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/search_tools">
        <RelativeLayout android:layout_width="match_parent" android:layout_height="match_parent">
            <TextView
                android:id="@+id/notice_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:padding="24dp"
                android:text="@string/empty_gamelist"
                android:textColor="@color/mw_ui_text_2"
                android:textSize="14sp"
                android:visibility="gone" />
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/grid_games"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="12dp"
                android:paddingTop="2dp"
                android:paddingEnd="12dp"
                android:paddingBottom="14dp"
                android:scrollbars="vertical" />
        </RelativeLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottom_nav"
        android:layout_width="0dp"
        android:layout_height="82dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="8dp"
        app:cardBackgroundColor="@color/mw_ui_surface"
        app:cardCornerRadius="36dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeColor="@color/mw_ui_border"
        app:strokeWidth="1dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="horizontal" android:padding="6dp">
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/nav_home_shell"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/mw_ui_accent_soft"
                app:cardCornerRadius="28dp"
                app:cardElevation="0dp">
                <LinearLayout android:id="@+id/nav_home" android:layout_width="match_parent" android:layout_height="match_parent" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical">
                    <ImageView android:id="@+id/nav_home_icon" android:layout_width="27dp" android:layout_height="27dp" android:contentDescription="@null" android:src="@drawable/ic_home" app:tint="@color/mw_ui_accent" />
                    <TextView android:id="@+id/nav_home_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/mw_ui_home" android:textColor="@color/mw_ui_accent_hi" android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/nav_games_shell"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="28dp"
                app:cardElevation="0dp">
                <LinearLayout android:id="@+id/nav_games" android:layout_width="match_parent" android:layout_height="match_parent" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical">
                    <ImageView android:id="@+id/nav_games_icon" android:layout_width="28dp" android:layout_height="28dp" android:contentDescription="@null" android:src="@drawable/ic_controller" app:tint="@color/mw_ui_text_2" />
                    <TextView android:id="@+id/nav_games_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/mw_ui_games" android:textColor="@color/mw_ui_text_2" android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/nav_settings_shell"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="28dp"
                app:cardElevation="0dp">
                <LinearLayout android:id="@+id/nav_settings" android:layout_width="match_parent" android:layout_height="match_parent" android:clickable="true" android:focusable="true" android:gravity="center" android:orientation="vertical">
                    <ImageView android:id="@+id/nav_settings_icon" android:layout_width="28dp" android:layout_height="28dp" android:contentDescription="@null" android:src="@drawable/ic_settings" app:tint="@color/mw_ui_text_2" />
                    <TextView android:id="@+id/nav_settings_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/mw_ui_settings" android:textColor="@color/mw_ui_text_2" android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
