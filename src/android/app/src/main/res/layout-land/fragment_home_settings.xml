<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/moonwitch_background">

    <LinearLayout
        android:id="@+id/performance_rail"
        android:layout_width="108dp"
        android:layout_height="0dp"
        android:background="#B8060A13"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_moonwitch_mark" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.16"
            android:text="@string/app_name"
            android:textAllCaps="true"
            android:textColor="@color/moonwitch_text"
            android:textSize="9sp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/nav_performance_card"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="#B8101929"
            app:cardCornerRadius="0dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/moonwitch_cyan"
            app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
                <ImageView android:layout_width="25dp" android:layout_height="25dp" android:contentDescription="@null" android:src="@drawable/ic_mw_gauge" app:tint="@color/moonwitch_cyan" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/mw_performance" android:textAllCaps="true" android:textColor="@color/moonwitch_cyan" android:textSize="8.5sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/nav_games_card"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="0dp"
            app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="@null" android:src="@drawable/ic_controller" app:tint="@color/moonwitch_text_muted" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/mw_games" android:textAllCaps="true" android:textColor="@color/moonwitch_text_muted" android:textSize="8.5sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/nav_system_card"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="0dp"
            app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="@null" android:src="@drawable/ic_mw_system" app:tint="@color/moonwitch_text_muted" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/mw_system" android:textAllCaps="true" android:textColor="@color/moonwitch_text_muted" android:textSize="8.5sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/nav_updates_card"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="0dp"
            app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="@null" android:src="@drawable/ic_system_update_alt" app:tint="@color/moonwitch_text_muted" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/mw_updates" android:textAllCaps="true" android:textColor="@color/moonwitch_text_muted" android:textSize="8.5sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/help_card"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginBottom="8dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="0dp"
            app:cardElevation="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:contentDescription="@null" android:src="@drawable/ic_info_outline" app:tint="@color/moonwitch_text_muted" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/mw_about_short" android:textAllCaps="true" android:textColor="@color/moonwitch_text_muted" android:textSize="8.5sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header_settings"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:paddingStart="22dp"
        android:paddingEnd="18dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/performance_rail"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/performance_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed"
            android:text="@string/mw_graphics_performance"
            android:textAllCaps="true"
            android:textColor="@color/moonwitch_text"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/device_badge"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/device_badge"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            app:cardBackgroundColor="@color/moonwitch_panel_high"
            app:cardCornerRadius="7dp"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:strokeColor="@color/moonwitch_border"
            app:strokeWidth="1dp">
            <TextView
                android:id="@+id/device_badge_text"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:textColor="@color/moonwitch_cyan"
                android:textSize="9sp"
                tools:text="POCO F5" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/settings_shortcut_card"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/settings_search_shell"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone"
        app:layout_constraintStart_toEndOf="@id/performance_rail"
        app:layout_constraintTop_toBottomOf="@id/header_settings">
        <EditText
            android:id="@+id/settings_search_text"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:background="@android:color/transparent"
            android:inputType="text" />
    </com.google.android.material.card.MaterialCardView>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view_settings"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/performance_rail"
        app:layout_constraintTop_toBottomOf="@id/header_settings">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="10dp"
            android:paddingEnd="18dp"
            android:paddingBottom="12dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/quick_resolution"
                    android:layout_width="0dp" android:layout_height="64dp" android:layout_marginEnd="5dp" android:layout_weight="1" android:clickable="true" android:focusable="true"
                    app:cardBackgroundColor="@color/moonwitch_panel_soft" app:cardCornerRadius="10dp" app:cardElevation="0dp" app:rippleColor="#3035D8FF" app:strokeColor="@color/moonwitch_border" app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="12dp">
                        <ImageView android:layout_width="26dp" android:layout_height="26dp" android:contentDescription="@null" android:src="@drawable/ic_graphics" app:tint="@color/moonwitch_text_muted" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:text="@string/mw_resolution" android:textAllCaps="true" android:textColor="@color/moonwitch_text" android:textSize="11sp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/mw_resolution_desc" android:textColor="@color/moonwitch_text_muted" android:textSize="8.5sp" />
                        </LinearLayout>
                        <TextView android:id="@+id/quick_resolution_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/moonwitch_cyan" android:textSize="12sp" tools:text="1X" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/quick_dock"
                    android:layout_width="0dp" android:layout_height="64dp" android:layout_marginStart="5dp" android:layout_weight="1"
                    app:cardBackgroundColor="@color/moonwitch_panel_soft" app:cardCornerRadius="10dp" app:cardElevation="0dp" app:strokeColor="@color/moonwitch_border" app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="12dp">
                        <ImageView android:layout_width="26dp" android:layout_height="26dp" android:contentDescription="@null" android:src="@drawable/ic_system" app:tint="@color/moonwitch_text_muted" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:text="@string/mw_dock_mode" android:textAllCaps="true" android:textColor="@color/moonwitch_text" android:textSize="11sp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/mw_dock_mode_desc" android:textColor="@color/moonwitch_text_muted" android:textSize="8.5sp" />
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/quick_dock_switch" android:layout_width="wrap_content" android:layout_height="wrap_content" android:contentDescription="@string/mw_dock_mode" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/quick_cas"
                    android:layout_width="0dp" android:layout_height="70dp" android:layout_marginEnd="5dp" android:layout_weight="1"
                    app:cardBackgroundColor="@color/moonwitch_panel_soft" app:cardCornerRadius="10dp" app:cardElevation="0dp" app:strokeColor="@color/moonwitch_border" app:strokeWidth="1dp">
                    <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="match_parent" android:paddingHorizontal="12dp">
                        <ImageView android:id="@+id/cas_icon" android:layout_width="26dp" android:layout_height="26dp" android:contentDescription="@null" android:src="@drawable/ic_graphics" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toTopOf="@id/quick_cas_slider" app:tint="@color/moonwitch_text_muted" />
                        <TextView android:id="@+id/cas_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:fontFamily="sans-serif-medium" android:text="@string/mw_cas" android:textAllCaps="true" android:textColor="@color/moonwitch_text" android:textSize="11sp" app:layout_constraintBottom_toBottomOf="@id/cas_icon" app:layout_constraintEnd_toStartOf="@id/quick_cas_value" app:layout_constraintStart_toEndOf="@id/cas_icon" app:layout_constraintTop_toTopOf="@id/cas_icon" />
                        <TextView android:id="@+id/quick_cas_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/moonwitch_cyan" android:textSize="14sp" app:layout_constraintBottom_toBottomOf="@id/cas_icon" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="@id/cas_icon" tools:text="35%" />
                        <com.google.android.material.slider.Slider android:id="@+id/quick_cas_slider" android:layout_width="0dp" android:layout_height="30dp" android:valueFrom="0" android:valueTo="100" android:stepSize="1" app:labelBehavior="gone" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:thumbColor="@color/moonwitch_cyan" app:trackColorActive="@color/moonwitch_cyan" app:trackColorInactive="@color/moonwitch_border" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/quick_safs"
                    android:layout_width="0dp" android:layout_height="70dp" android:layout_marginStart="5dp" android:layout_weight="1"
                    app:cardBackgroundColor="@color/moonwitch_panel_soft" app:cardCornerRadius="10dp" app:cardElevation="0dp" app:strokeColor="@color/moonwitch_border" app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="12dp">
                        <ImageView android:layout_width="26dp" android:layout_height="26dp" android:contentDescription="@null" android:src="@drawable/ic_frames" app:tint="@color/moonwitch_text_muted" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:text="@string/mw_safs" android:textAllCaps="true" android:textColor="@color/moonwitch_text" android:textSize="10.5sp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/mw_safs_short_desc" android:textColor="@color/moonwitch_text_muted" android:textSize="8.5sp" />
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/quick_safs_switch" android:layout_width="wrap_content" android:layout_height="wrap_content" android:contentDescription="@string/mw_safs" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/quick_frame_pacing"
                    android:layout_width="0dp" android:layout_height="64dp" android:layout_marginEnd="5dp" android:layout_weight="1" android:clickable="true" android:focusable="true"
                    app:cardBackgroundColor="@color/moonwitch_panel_soft" app:cardCornerRadius="10dp" app:cardElevation="0dp" app:rippleColor="#3035D8FF" app:strokeColor="@color/moonwitch_border" app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="12dp">
                        <ImageView android:layout_width="26dp" android:layout_height="26dp" android:contentDescription="@null" android:src="@drawable/ic_frames" app:tint="@color/moonwitch_text_muted" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:text="@string/mw_frame_pacing" android:textAllCaps="true" android:textColor="@color/moonwitch_text" android:textSize="11sp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/mw_frame_pacing_short_desc" android:textColor="@color/moonwitch_text_muted" android:textSize="8.5sp" />
                        </LinearLayout>
                        <TextView android:id="@+id/quick_frame_pacing_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/moonwitch_cyan" android:textSize="10sp" tools:text="AUTOMÁTICO" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/quick_adpf"
                    android:layout_width="0dp" android:layout_height="64dp" android:layout_marginStart="5dp" android:layout_weight="1" android:clickable="true" android:focusable="true"
                    app:cardBackgroundColor="@color/moonwitch_panel_soft" app:cardCornerRadius="10dp" app:cardElevation="0dp" app:rippleColor="#3035D8FF" app:strokeColor="@color/moonwitch_border" app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="12dp">
                        <ImageView android:layout_width="26dp" android:layout_height="26dp" android:contentDescription="@null" android:src="@drawable/ic_mw_gauge" app:tint="@color/moonwitch_text_muted" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:text="ADPF" android:textColor="@color/moonwitch_text" android:textSize="11sp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/mw_adpf_short_desc" android:textColor="@color/moonwitch_text_muted" android:textSize="8.5sp" />
                        </LinearLayout>
                        <TextView android:id="@+id/quick_adpf_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/moonwitch_cyan" android:textSize="9sp" tools:text="ATIVO" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/quick_driver"
                    android:layout_width="0dp" android:layout_height="64dp" android:layout_marginEnd="5dp" android:layout_weight="1" android:clickable="true" android:focusable="true"
                    app:cardBackgroundColor="@color/moonwitch_panel_soft" app:cardCornerRadius="10dp" app:cardElevation="0dp" app:rippleColor="#3035D8FF" app:strokeColor="@color/moonwitch_border" app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="12dp">
                        <ImageView android:layout_width="26dp" android:layout_height="26dp" android:contentDescription="@null" android:src="@drawable/ic_build" app:tint="@color/moonwitch_text_muted" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:text="@string/mw_driver" android:textAllCaps="true" android:textColor="@color/moonwitch_text" android:textSize="11sp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/mw_driver_desc" android:textColor="@color/moonwitch_text_muted" android:textSize="8.5sp" />
                        </LinearLayout>
                        <TextView android:id="@+id/quick_driver_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:ellipsize="end" android:maxWidth="120dp" android:maxLines="1" android:textColor="@color/moonwitch_cyan" android:textSize="9sp" tools:text="Turnip R19" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/quick_per_game"
                    android:layout_width="0dp" android:layout_height="64dp" android:layout_marginStart="5dp" android:layout_weight="1" android:clickable="true" android:focusable="true"
                    app:cardBackgroundColor="@color/moonwitch_panel_soft" app:cardCornerRadius="10dp" app:cardElevation="0dp" app:rippleColor="#3035D8FF" app:strokeColor="@color/moonwitch_border" app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="12dp">
                        <ImageView android:layout_width="26dp" android:layout_height="26dp" android:contentDescription="@null" android:src="@drawable/ic_controller" app:tint="@color/moonwitch_text_muted" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:text="@string/mw_per_game_profiles" android:textAllCaps="true" android:textColor="@color/moonwitch_text" android:textSize="11sp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/mw_per_game_profiles_desc" android:textColor="@color/moonwitch_text_muted" android:textSize="8.5sp" />
                        </LinearLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/mw_choose_game_short" android:textColor="@color/moonwitch_cyan" android:textSize="9sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/performance_summary"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginTop="9dp"
                app:cardBackgroundColor="@color/moonwitch_panel_soft"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/moonwitch_border"
                app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="14dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                        <TextView android:id="@+id/quick_summary_fps" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:textColor="@color/moonwitch_cyan" android:textSize="22sp" tools:text="30 FPS" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/mw_frame_rate" android:textAllCaps="true" android:textColor="@color/moonwitch_text_muted" android:textSize="8sp" />
                    </LinearLayout>
                    <View android:layout_width="1dp" android:layout_height="42dp" android:background="@color/moonwitch_border" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                        <TextView android:id="@+id/quick_summary_frametime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:textColor="@color/moonwitch_cyan" android:textSize="22sp" tools:text="16.7 ms" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/mw_frame_time" android:textAllCaps="true" android:textColor="@color/moonwitch_text_muted" android:textSize="8sp" />
                    </LinearLayout>
                    <View android:layout_width="1dp" android:layout_height="42dp" android:background="@color/moonwitch_border" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                        <TextView android:id="@+id/quick_summary_state" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:textColor="@color/moonwitch_cyan" android:textSize="16sp" tools:text="ESTÁVEL" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/mw_performance" android:textAllCaps="true" android:textColor="@color/moonwitch_text_muted" android:textSize="8sp" />
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/quick_details"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:text="@string/mw_view_details"
                        android:textColor="@color/moonwitch_red"
                        android:textSize="9sp"
                        app:strokeColor="@color/moonwitch_red" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:gravity="center_vertical|end" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/mw_settings_saved_automatically" android:textColor="@color/moonwitch_text_muted" android:textSize="8.5sp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/quick_reset" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="42dp" android:text="@string/mw_restore_defaults" android:textColor="@color/moonwitch_red" android:textSize="9sp" app:icon="@drawable/ic_restore" app:iconSize="16dp" app:iconTint="@color/moonwitch_red" app:strokeColor="@color/moonwitch_red" />
                <com.google.android.material.button.MaterialButton android:id="@+id/quick_apply" android:layout_width="wrap_content" android:layout_height="42dp" android:layout_marginStart="8dp" android:backgroundTint="@color/moonwitch_cyan" android:text="@string/mw_apply_changes" android:textColor="#07101A" android:textSize="9sp" app:icon="@drawable/ic_check" app:iconSize="16dp" app:iconTint="#07101A" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView android:id="@+id/home_settings_list" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/performance_settings_list" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
